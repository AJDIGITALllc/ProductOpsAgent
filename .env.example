# ProductOpsAgent Environment Variables
# DO NOT use .env files in production - use platform secret managers only!

# Core Configuration
NODE_ENV=development
PORT=3000

# Planner Configuration (REQUIRED)
PLANNER_MODE=OPENAI
# PLANNER_MODE=CLAUDE

# AI API Keys (Platform Secret Manager ONLY in production)
OPENAI_API_KEY=sk-...
CLAUDE_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Whop API Configuration (Platform Secret Manager ONLY in production)
WHOP_API_KEY=...
WHOP_APP_ID=...
WHOP_APP_SECRET=...
WHOP_OAUTH_REDIRECT_URL=https://ops.audiojones.com/auth/callback
WHOP_WEBHOOK_SECRET=...

# Deployment Configuration
API_URL=https://ops-api.audiojones.com
UI_URL=https://ops.audiojones.com

# CORS Configuration
CORS_ORIGIN=https://ops.audiojones.com

# Safety Controls
EXECUTION_DISABLED=false
DAILY_EXECUTION_QUOTA=100
DAILY_PLANNER_QUOTA=1000
DAILY_IMAGE_QUOTA=50

# Storage Configuration
STORAGE_BUCKET=productops-assets
STORAGE_REGION=us-east-1
