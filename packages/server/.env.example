# Server
PORT=3001
NODE_ENV=development

# Database (relative path from server to database/prisma)
DATABASE_URL="file:../database/prisma/dev.db"

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ISSUER=product-ops-agent
JWT_AUDIENCE=product-ops-agent-api
JWT_EXPIRES_IN=24h

# Whop API
WHOP_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Planner Mode: RULES or OPENAI
PLANNER_MODE=RULES

# Webhooks
WEBHOOK_URL=http://localhost:3002/webhooks
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_MS=1000
WEBHOOK_RETRY_BACKOFF_MULTIPLIER=2

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# User Allowlist (JSON array of user configs)
USER_ALLOWLIST=[{"sub":"admin","role":"Owner"},{"sub":"user1","role":"User"}]
