{
  "name": "product-ops-agent",
  "version": "1.0.0",
  "description": "A chat UI where the user says: 'Create a new product called X, price it at Y, make it recurring, add FAQs,' and an agent executes those actions through the Whop API with guardrails, logging, and rollback.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/server",
    "dev:ui": "npm run dev --workspace=packages/admin-ui",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run migrate:dev --workspace=packages/database",
    "db:generate": "npm run generate --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "db:studio": "npm run studio --workspace=packages/database",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "whop",
    "automation",
    "agent",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
