{
  "environment": "staging",
  "admin_ui": {
    "domain": "staging-ops.audiojones.com",
    "ssl": true,
    "hsts": {
      "enabled": true,
      "maxAge": 31536000,
      "includeSubDomains": true,
      "preload": false
    },
    "cors": {
      "allowedOrigins": ["https://staging-ops-api.audiojones.com"],
      "credentials": true
    },
    "cookies": {
      "secure": true,
      "httpOnly": true,
      "sameSite": "lax",
      "domain": ".audiojones.com"
    }
  },
  "api": {
    "domain": "staging-ops-api.audiojones.com",
    "ssl": true,
    "hsts": {
      "enabled": true,
      "maxAge": 31536000,
      "includeSubDomains": true,
      "preload": false
    },
    "cors": {
      "allowedOrigins": ["https://staging-ops.audiojones.com"],
      "credentials": true,
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allowedHeaders": ["Content-Type", "Authorization", "X-Request-ID"]
    },
    "cookies": {
      "secure": true,
      "httpOnly": true,
      "sameSite": "lax",
      "domain": ".audiojones.com"
    },
    "rateLimit": {
      "windowMs": 900000,
      "max": 200
    }
  },
  "required_env_vars": [
    "NODE_ENV",
    "PLANNER_MODE",
    "OPENAI_API_KEY",
    "WHOP_API_KEY",
    "WHOP_APP_ID",
    "WHOP_APP_SECRET",
    "WHOP_OAUTH_REDIRECT_URL",
    "WHOP_WEBHOOK_SECRET",
    "GEMINI_API_KEY",
    "STORAGE_BUCKET",
    "STORAGE_REGION",
    "COOKIE_SECRET",
    "API_URL",
    "UI_URL",
    "CORS_ORIGIN"
  ],
  "optional_env_vars": [
    "EXECUTION_DISABLED",
    "CLAUDE_API_KEY",
    "DAILY_EXECUTION_QUOTA",
    "DAILY_PLANNER_QUOTA",
    "DAILY_IMAGE_QUOTA"
  ]
}
